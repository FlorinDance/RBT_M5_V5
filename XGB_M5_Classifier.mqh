   double m = MathMax(s0, MathMax(s1, s2));

   double e0 = MathExp(s0 - m);

   double e1 = MathExp(s1 - m);

   double e2 = MathExp(s2 - m);

   double z = e0 + e1 + e2;

   if(z <= 0.0) { pSell=0.0; pHold=1.0; pBuy=0.0; decision=1; return; }

   pSell = e0 / z;

   pHold = e1 / z;

   pBuy  = e2 / z;

   decision = 1;

   double best = pHold;

   if(pSell > best) { best = pSell; decision = 0; }

   if(pBuy  > best) { best = pBuy;  decision = 2; }

